% Editable vector architecture. Labels occupy only the reserved inter-node gaps.
% No opaque label backgrounds, labels inside boxes, or crossing flow routes.
\begin{tikzpicture}[>=Stealth,font=\scriptsize,
 block/.style={draw=black!75,rounded corners=1.5pt,align=center,
 text width=31mm,minimum height=12mm,inner sep=2.5pt},
 flow/.style={->,semithick},
 artifact/.style={->,dashed,black!65},
 label/.style={font=\scriptsize,inner sep=1pt}]
\node[block,text width=75mm,fill=black!4] (train) at (2.2,1.55)
 {\textbf{Offline training and model selection}\\
 480 queries; grouped five-fold cross-validation\\
 Frozen predictors $f_1,f_2$ and safety margins $m_1,m_2$};
\node[block] (plan) at (0,0)
 {\textbf{SQL + Catalyst plan}\\
 Input size, joins and shuffle\\
 Graph depth and fan-out};
\node[block,fill=blue!5] (s1) at (4.4,0)
 {\textbf{Stage 1: plan predictor}\\
 $\hat n_1=f_1(x;m_1)$\\
 Before query execution};
\node[block,fill=blue!5] (s2) at (0,-1.65)
 {\textbf{Stage 2: shuffle correction}\\
 $\hat n_2=f_2(x,z;m_2)$\\
 At first completed shuffle};
\node[block,fill=black!4] (control) at (4.4,-1.65)
 {\textbf{Allocation controller}\\
 Calibrate and clamp to supply\\
 Start $n_1$; then $\max(n_1,n_2)$};
\node[block] (monitor) at (0,-3.3)
 {\textbf{Runtime monitor (250 ms)}\\
 Shuffle bytes; active tasks\\
 Configured-partition fallback};
\node[block] (exec) at (4.4,-3.3)
 {\textbf{Spark SQL workers}\\
 4 slots; 2 cores per executor\\
 1536 MB per executor};
% Frozen artifacts: a vertical route to Stage 1 and an exterior route to Stage 2.
\draw[artifact] (train.south -| s1.north)--(s1.north);
\draw[artifact] (train.west)--(-2.08,1.55)--(-2.08,-1.65)--(s2.west);
% Live data and control: short symbols fit inside the clear inter-node gutters.
\draw[flow] (plan.east)--node[label,above=1pt]{$x$}(s1.west);
\draw[flow] (s1.south)--node[label,right=1pt]{$\hat n_1$}(control.north);
\draw[flow] (s2.east)--node[label,above=1pt]{$\hat n_2$}(control.west);
\draw[flow] (control.south)--node[label,right=1pt]{$n_{\mathrm{next}}$}(exec.north);
\draw[flow] (exec.west)--node[label,above=1pt]{Stats}(monitor.east);
\draw[flow] (monitor.north)--node[label,right=1pt]{$z$}(s2.south);
\end{tikzpicture}
